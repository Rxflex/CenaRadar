# Cena Radar runs with zero configuration.

# All scraping uses public kupi.cz pages. No API keys needed.

# If you fork the project and want to add a third-party service,
# copy this file to `.env.local` and fill in real values.
# `.env*` is gitignored — never commit secrets.

# --- Example: turn on Next.js telemetry ---
# NEXT_TELEMETRY_DISABLED=0

# --- Example: rate-limit overrides ---
# RATE_LIMIT_SEARCH_PER_MIN=30
# RATE_LIMIT_SEARCH_WINDOW_MS=60000

# --- Example: an analytics key (if you fork and add one) ---
# ANALYTICS_WRITE_KEY=
